server {
    listen 80;

    root /usr/share/nginx/html;
    index index.html;

    # Dashboard JSON API → noroshi monitor. API_BACKEND is substituted at
    # container start (nginx entrypoint envsubst) — compose service name
    # locally, the monitor's public https URL on Coolify.
    location /api/ {
        proxy_pass ${API_BACKEND};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Status badges → noroshi monitor
    location /badge/ {
        proxy_pass ${API_BACKEND};
        proxy_set_header Host $host;
    }

    # SPA fallback: every unknown path serves the app shell
    location / {
        try_files $uri $uri/ /index.html;
    }
}
