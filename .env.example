# Required
TELEGRAM_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=-100123456789

# Optional
DATABASE_PATH=./data/uptime.db
HTTP_TIMEOUT=10s
MAX_FAILURE_NOTIFICATIONS=3
# Consecutive failures before the first alert (1 = alert immediately)
FAILURE_THRESHOLD=1
# Re-alert while an outage continues (0 = off, e.g. 2h)
REMINDER_INTERVAL=0
# Mark healthy endpoints as slow above this latency in ms (0 = off)
SLOW_THRESHOLD_MS=0
LOG_LEVEL=info
# If you change HEALTH_PORT, the Dockerfile HEALTHCHECK picks it up
# automatically at runtime (${HEALTH_PORT:-8080}).
HEALTH_PORT=8080
